extends baseEmail
block content
    p Hi #{firstName},
        p Forget your password? No worries, click the button below to reset it. This link is only valid for the next 10 minutes ⏳#{url}.
        p (Website fot this action is not yet built, so the link will simply take you to the homepage)
        table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
                tr
                    td(align='left')
                        table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                            tbody
                                tr
                                    td
                                        a(href='${url}', target='_blank') Reset password
        p If you need any help with booking your next tour, please don't hesitate to contact me!
        
